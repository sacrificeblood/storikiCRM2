# Postgres connection string from your free database provider (Neon, Supabase, etc.)
DATABASE_URL=postgres://user:password@host:5432/dbname

NODE_ENV=production
PORT=3000

# Optional — leave blank to disable. Sends a Telegram message when a task on the "Задачи"
# board is created, moved between columns, or deleted.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
